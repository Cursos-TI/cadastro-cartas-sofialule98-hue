#include <stdio.h>

int main() {
    char estado1[3], cidade1[20], cod1[4];
    unsigned long int populacao1;
    int turismo1;
    float area1, pib1;
    
    char estado2[3], cidade2[20], cod2[4];
    unsigned long int populacao2;
    int turismo2;
    float area2, pib2;
    
    float densidade1, densidade2;
    float pibPerCapita1, pibPerCapita2;
    float superPoder1, superPoder2;
    
    printf("\n=== CARTA 1 ===\n");
    
    printf("Código: ");
    scanf(" %3s", cod1);
    
    printf("Estado: ");
    scanf(" %s", estado1);
    
    printf("Cidade: ");
    scanf(" %s", cidade1);
    
    printf("População: ");
    scanf("%lu", &populacao1); // %lu para unsigned long int
    
    printf("Número de Pontos Turísticos: ");
    scanf("%d", &turismo1);
    
    printf("Área (km²): ");
    scanf("%f", &area1);
    
    printf("PIB (bilhões de reais): ");
    scanf("%f", &pib1);
    
    printf("\n=== CARTA 2 ===\n");
    
    printf("Código: ");
    scanf(" %3s", cod2);
    
    printf("Estado: ");
    scanf(" %s", estado2);
    
    printf("Cidade: ");
    scanf(" %s", cidade2);
    
    printf("População: ");
    scanf("%lu", &populacao2);
    
    printf("Número de Pontos Turísticos: ");
    scanf("%d", &turismo2);
    
    printf("Área (km²): ");
    scanf("%f", &area2);
    
    printf("PIB (bilhões de reais): ");
    scanf("%f", &pib2);
    
    densidade1 = (float)populacao1 / area1;
    densidade2 = (float)populacao2 / area2;
    
    pibPerCapita1 = (pib1 * 1000000000) / (float)populacao1;
    pibPerCapita2 = (pib2 * 1000000000) / (float)populacao2;
    
    superPoder1 = (float)populacao1 + area1 + pib1 + (float)turismo1 + 
                  pibPerCapita1 + (1.0f / densidade1);
    superPoder2 = (float)populacao2 + area2 + pib2 + (float)turismo2 + 
                  pibPerCapita2 + (1.0f / densidade2);
    
    printf("\n====================================\n");
    printf("=== DADOS DAS CARTAS ===\n");
    printf("====================================\n");
    
    printf("\n--- CARTA 1 ---\n");
    printf("Estado: %s\n", estado1);
    printf("Código: %s\n", cod1);
    printf("Cidade: %s\n", cidade1);
    printf("População: %lu habitantes\n", populacao1);
    printf("Área: %.2f km²\n", area1);
    printf("PIB: %.2f bilhões de reais\n", pib1);
    printf("Pontos Turísticos: %d\n", turismo1);
    printf("Densidade Populacional: %.2f hab/km²\n", densidade1);
    printf("PIB per Capita: %.2f reais\n", pibPerCapita1);
    printf("Super Poder: %.2f\n", superPoder1);
    
    printf("\n--- CARTA 2 ---\n");
    printf("Estado: %s\n", estado2);
    printf("Código: %s\n", cod2);
    printf("Cidade: %s\n", cidade2);
    printf("População: %lu habitantes\n", populacao2);
    printf("Área: %.2f km²\n", area2);
    printf("PIB: %.2f bilhões de reais\n", pib2);
    printf("Pontos Turísticos: %d\n", turismo2);
    printf("Densidade Populacional: %.2f hab/km²\n", densidade2);
    printf("PIB per Capita: %.2f reais\n", pibPerCapita2);
    printf("Super Poder: %.2f\n", superPoder2);
    
    printf("\n====================================\n");
    printf("=== COMPARAÇÃO DE CARTAS ===\n");
    printf("====================================\n");
    
    if (populacao1 > populacao2) {
        printf("População: Carta 1 venceu (1)\n");
    } else {
        printf("População: Carta 2 venceu (0)\n");
    }
    
    if (area1 > area2) {
        printf("Área: Carta 1 venceu (1)\n");
    } else {
        printf("Área: Carta 2 venceu (0)\n");
    }
    
    if (pib1 > pib2) {
        printf("PIB: Carta 1 venceu (1)\n");
    } else {
        printf("PIB: Carta 2 venceu (0)\n");
    }
    
    if (turismo1 > turismo2) {
        printf("Pontos Turísticos: Carta 1 venceu (1)\n");
    } else {
        printf("Pontos Turísticos: Carta 2 venceu (0)\n");
    }
    
    if (densidade1 < densidade2) {
        printf("Densidade Populacional: Carta 1 venceu (1)\n");
    } else {
        printf("Densidade Populacional: Carta 2 venceu (0)\n");
    }
    
    if (pibPerCapita1 > pibPerCapita2) {
        printf("PIB per Capita: Carta 1 venceu (1)\n");
    } else {
        printf("PIB per Capita: Carta 2 venceu (0)\n");
    }
    
    // Super Poder (maior vence)
    if (superPoder1 > superPoder2) {
        printf("Super Poder: Carta 1 venceu (1)\n");
    } else {
        printf("Super Poder: Carta 2 venceu (0)\n");
    }
    
    return 0;
}