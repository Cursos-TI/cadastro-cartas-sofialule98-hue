#include <stdio.h>

int main() {
    
    printf("=== BATALHA NAVAL - HABILIDADES ESPECIAIS ===\n\n");
    
    int tabuleiro[10][10];
    
    printf("--- Inicializando tabuleiro 10x10 ---\n");
    for (int linha = 0; linha < 10; linha++) {
        for (int coluna = 0; coluna < 10; coluna++) {
            tabuleiro[linha][coluna] = 0;
        }
    }
    printf("Tabuleiro inicializado com 0 (posições vazias)\n\n");
    
    
    int cone[5][5];
    int cruz[5][5];
    int octaedro[5][5];
    
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            cone[i][j] = 0;
            cruz[i][j] = 0;
            octaedro[i][j] = 0;
        }
    }

    printf("--- Criando padrão CONE (5x5) ---\n");
    
    cone[0][2] = 1; // linha 0: apenas posição central coluna 2 = 1
    
    cone[1][1] = 1; // linha 1: colunas 1, 2, 3 = 1
    cone[1][2] = 1;
    cone[1][3] = 1;
    
    for (int coluna = 0; coluna < 5; coluna++) {  // linha 2: todas as colunas = 1
        cone[2][coluna] = 1;
    }
    
    printf("--- Criando padrão CRUZ (5x5) ---\n");
    
    for (int linha = 0; linha < 5; linha++) {  // linha vertical central (coluna) em todas as linhas
        cruz[linha][2] = 1;
    }
    
    for (int coluna = 0; coluna < 5; coluna++) {  // linha horizontal central (linha) em todas as colunas
        cruz[2][coluna] = 1;
    }
    
    printf("--- Criando padrão OCTAEDRO (5x5) ---\n");
    
    octaedro[0][2] = 1;  // linha 0: apenas posição central (coluna 2) = 1
    
    octaedro[1][1] = 1;  // linha 1: colunas 1, 2, 3 = 1
    octaedro[1][2] = 1;
    octaedro[1][3] = 1;
    
    octaedro[2][2] = 1;  // linha 2: apenas posição central (coluna 2) = 1

    printf("\n");
    
    printf("=== HABILIDADE: CONE ===\n");
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            printf("%d ", cone[i][j]);
        }
        printf("\n"); // quebra de linha após cada linha da matriz
    }
    printf("\n");
    
    printf("=== HABILIDADE: CRUZ ===\n");
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            printf("%d ", cruz[i][j]);
        }
        printf("\n");
    }
    printf("\n");
    
    printf("=== HABILIDADE: OCTAEDRO ===\n");
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            printf("%d ", octaedro[i][j]);
        }
        printf("\n");
    }
    printf("\n");

    printf("=== DEMONSTRAÇÃO: APLICANDO HABILIDADE CONE NO TABULEIRO ===\n");
    printf("(Posição de origem da habilidade: linha 3, coluna 3)\n\n");
    
    int tabuleiroComHabilidade[10][10];
    
    for (int i = 0; i < 10; i++) {
        for (int j = 0; j < 10; j++) {
            tabuleiroComHabilidade[i][j] = tabuleiro[i][j];
        }
    }
    
    int origemLinha = 3;
    int origemColuna = 3;

    for (int i = 0; i < 5; i++) {  // aplicando o cone no tabuleiro
        for (int j = 0; j < 5; j++) {
            int linhaTab = origemLinha - 2 + i;  // o cone é sobreposto a partir da posição (origemLinha - 2, origemColuna - 2)
            int colunaTab = origemColuna - 2 + j;  // para centralizar a matriz 5x5 na origem
            

            if (linhaTab >= 0 && linhaTab < 10 && colunaTab >= 0 && colunaTab < 10) {  // verifica se está dentro dos limites do tabuleiro
                if (cone[i][j] == 1) {  // se a matriz de habilidade tiver valor 1, marca no tabuleiro
                    tabuleiroComHabilidade[linhaTab][colunaTab] = 1;
                }
            }
        }
    }
    
    printf("Tabuleiro com área de efeito do CONE (1 = área afetada):\n\n");
    for (int i = 0; i < 10; i++) {
        for (int j = 0; j < 10; j++) {
            printf("%d ", tabuleiroComHabilidade[i][j]);
        }
        printf("\n");
    }
    printf("\n");
    
    printf("=== APENAS AS ÁREAS AFETADAS (MATRIZES ISOLADAS) ===\n\n");
    
    printf("Habilidade em CONE (apenas área afetada):\n");
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            if (cone[i][j] == 1) {
                printf("1 ");
            } else {
                printf("0 ");
            }
        }
        printf("\n");
    }
    printf("\n");
    
    printf("Habilidade em CRUZ (apenas área afetada):\n");
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            if (cruz[i][j] == 1) {
                printf("1 ");
            } else {
                printf("0 ");
            }
        }
        printf("\n");
    }
    printf("\n");
    
    printf("Habilidade em OCTAEDRO (apenas área afetada):\n");
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            if (octaedro[i][j] == 1) {
                printf("1 ");
            } else {
                printf("0 ");
            }
        }
        printf("\n");
    }
    printf("\n");
    
    return 0;
}