#include <stdio.h>

void moverBispo(int casas);
void moverTorre(int casas);
void moverRainha(int casas);

int main() {
    
    printf("=== DESAFIO MESTRE - XADREZ ===\n\n");
    
    printf("--- Movimento do Bispo (5 casas diagonal direita para cima) ---\n");
    moverBispo(5);
    printf("\n");
    
    printf("--- Movimento da Torre (5 casas para a direita) ---\n");
    moverTorre(5);
    printf("\n");
    
    printf("--- Movimento da Rainha (8 casas para a esquerda) ---\n");
    moverRainha(8);
    printf("\n");
    
    printf("--- Movimento do Cavalo (1 vez em L para cima à direita) ---\n");
    

    for (int cima = 1; cima <= 2; cima++) {  // loop externo para o movimento 2 casas para cima
        printf("Cima\n");
        
        // quando chegarmos na segunda casa para cima, fazemos o movimento para a direita
        if (cima == 2) {
            for (int direita = 1; direita <= 1; direita++) {  // loop interno para o movimento 1 casa para a direita
                printf("Direita\n");
            }
        }
    }

    return 0;
}

void moverBispo(int casas) {
    if (casas <= 0) {
        return; // caso base: quando não há mais casas para mover
    }
    
    printf("Cima, Direita\n");
    
    moverBispo(casas - 1);
}

void moverTorre(int casas) {
    if (casas <= 0) {
        return; // caso base
    }
    
    printf("Direita\n");
    
    moverTorre(casas - 1);
}

void moverRainha(int casas) {
    if (casas <= 0) {
        return; // caso base
    }
    
    printf("Esquerda\n");
    
    moverRainha(casas - 1);
}